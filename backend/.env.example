# 下载后默认本地模拟，不连接仓库所有者的模型账号，不产生模型调用费用。
# 真实生成需使用运行者自己的后端密钥，并明确确认费用和照片转发。
# 图像模型提供方：tudou / ark / siliconflow / modelscope / mock
IMAGE_PROVIDER=mock
IMAGE_TIMEOUT_SECONDS=120

# 火山方舟国内入口；密钥只填本地 .env，切勿填入本示例文件。
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL_ID=doubao-seedream-5-0-260128
ARK_TIMEOUT_SECONDS=180
# 预算估算值，不是供应商账单；真实调用前核实该模型的控制台单价。
ARK_ESTIMATED_COST_PER_IMAGE=0.30

# 土豆 Gemini 原生图片接口；人民币单价为 0 或照片授权 false 时阻止提交。
# 密钥只填写后端本地 .env；不要填写在本示例或前端。
TUDOU_API_BASE_URL=https://api.ai-tudou.net
TUDOU_API_KEY=
TUDOU_MODEL_ID=gemini-3.1-flash-image-preview
# 0 表示未核实报价，不能据此调用；不是免费。
TUDOU_ESTIMATED_COST_PER_IMAGE=0
TUDOU_PHOTO_TRANSFER_APPROVED=false
TUDOU_TIMEOUT_SECONDS=180

# 保留旧供应商，只有手动切换 IMAGE_PROVIDER 才启用。
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL_ID=Qwen/Qwen-Image-Edit-2509
MODELSCOPE_API_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL_ID=Qwen/Qwen-Image-Edit-2511
MODELSCOPE_POLL_TIMEOUT_SECONDS=300

COST_LIMIT_PER_IMAGE=0.30
COST_LIMIT_MONTHLY=300
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
TAOBAOKE_API_URL=
TAOBAOKE_APP_KEY=
TAOBAOKE_APP_SECRET=
TAOBAOKE_PID=
DATA_DIR=data
DATABASE_URL=sqlite:///./data/app.db
RESULT_RETENTION_DAYS=7
